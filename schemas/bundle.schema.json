{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "model_id",
    "version",
    "sample_rate",
    "runtime",
    "frontend",
    "components"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "model_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "sample_rate": {
      "type": "integer",
      "minimum": 1
    },
    "runtime": {
      "type": "object",
      "required": ["kind"]
    },
    "frontend": {
      "type": "object"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "file", "inputs", "outputs"]
      }
    }
  }
}
